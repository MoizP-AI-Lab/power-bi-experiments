```dax
DEFINE
    // Reference: written to the literal spec. "Ever" and "any time before" ignore every filter except the customer.
    MEASURE Sales[Sales LY] = CALCULATE ( [Sales Amount], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
    MEASURE Sales[Sales YTD] = CALCULATE ( [Sales Amount], DATESYTD ( 'Date'[Date] ) )
    MEASURE Sales[# New Customers] =
        VAR PeriodStart = MIN ( 'Date'[Date] )
        VAR PeriodEnd = MAX ( 'Date'[Date] )
        RETURN COUNTROWS ( FILTER ( VALUES ( Sales[CustomerKey] ),
            VAR FirstEver = CALCULATE ( MIN ( Sales[Order Date] ), ALLEXCEPT ( Sales, Sales[CustomerKey] ) )
            RETURN FirstEver >= PeriodStart && FirstEver <= PeriodEnd ) )
    MEASURE Sales[Sales Growth %] = VAR Prev = [Sales LY] RETURN DIVIDE ( [Sales Amount] - Prev, Prev )
    MEASURE Sales[Avg Delivery Days] =
        AVERAGEX ( SUMMARIZE ( Sales, Sales[Order Number], Sales[Order Date], Sales[Delivery Date] ),
            DATEDIFF ( Sales[Order Date], Sales[Delivery Date], DAY ) )
    MEASURE Sales[# Returning Customers] =
        VAR PeriodStart = MIN ( 'Date'[Date] )
        RETURN COUNTROWS ( FILTER ( VALUES ( Sales[CustomerKey] ),
            CALCULATE ( MIN ( Sales[Order Date] ), ALLEXCEPT ( Sales, Sales[CustomerKey] ) ) < PeriodStart ) )
    MEASURE Sales[Category Share %] = DIVIDE ( [Sales Amount], CALCULATE ( [Sales Amount], REMOVEFILTERS ( Product[Category] ) ) )
    MEASURE Sales[Sales 30D Avg] =
        DIVIDE ( CALCULATE ( [Sales Amount], DATESINPERIOD ( 'Date'[Date], MAX ( 'Date'[Date] ), -30, DAY ) ), 30 )
```
