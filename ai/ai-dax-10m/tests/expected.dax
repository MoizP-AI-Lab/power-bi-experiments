DEFINE
 VAR FirstEver = GROUPBY ( Sales, Sales[CustomerKey], "@f", MINX ( CURRENTGROUP (), Sales[Order Date] ) )
EVALUATE
UNION (
ROW ( "Context", "A 2024",
  "Sales LY", CALCULATE ( [Sales Amount], REMOVEFILTERS (), Sales[Order Date] >= dt"2023-01-01", Sales[Order Date] <= dt"2023-12-31" ),
  "Sales YTD", CALCULATE ( [Sales Amount], REMOVEFILTERS (), Sales[Order Date] >= dt"2024-01-01", Sales[Order Date] <= dt"2024-12-31" ),
  "# New Customers", VAR C = CALCULATETABLE ( VALUES ( Sales[CustomerKey] ), REMOVEFILTERS (), Sales[Order Date] >= dt"2024-01-01", Sales[Order Date] <= dt"2024-12-31" ) RETURN COUNTROWS ( FILTER ( FirstEver, [@f] >= dt"2024-01-01" && [@f] <= dt"2024-12-31" && Sales[CustomerKey] IN C ) ),
  "Sales Growth %", VAR Cur = CALCULATE ( [Sales Amount], REMOVEFILTERS (), Sales[Order Date] >= dt"2024-01-01", Sales[Order Date] <= dt"2024-12-31" ) VAR Prev = CALCULATE ( [Sales Amount], REMOVEFILTERS (), Sales[Order Date] >= dt"2023-01-01", Sales[Order Date] <= dt"2023-12-31" ) RETURN ( Cur - Prev ) / Prev,
  "Avg Delivery Days", AVERAGEX ( CALCULATETABLE ( SUMMARIZE ( Sales, Sales[Order Number], Sales[Order Date], Sales[Delivery Date] ), REMOVEFILTERS (), Sales[Order Date] >= dt"2024-01-01", Sales[Order Date] <= dt"2024-12-31" ), DATEDIFF ( Sales[Order Date], Sales[Delivery Date], DAY ) ),
  "# Returning Customers", VAR C = CALCULATETABLE ( VALUES ( Sales[CustomerKey] ), REMOVEFILTERS (), Sales[Order Date] >= dt"2024-01-01", Sales[Order Date] <= dt"2024-12-31" ) RETURN COUNTROWS ( FILTER ( FirstEver, [@f] < dt"2024-01-01" && Sales[CustomerKey] IN C ) ),
  "Category Share %", 1,
  "Sales 30D Avg", CALCULATE ( [Sales Amount], REMOVEFILTERS (), Sales[Order Date] > dt"2024-12-31" - 30, Sales[Order Date] <= dt"2024-12-31" ) / 30 ),
ROW ( "Context", "B 2024 Audio",
  "Sales LY", CALCULATE ( [Sales Amount], REMOVEFILTERS (), Sales[Order Date] >= dt"2023-01-01", Sales[Order Date] <= dt"2023-12-31", Product[Category] = "Audio" ),
  "Sales YTD", CALCULATE ( [Sales Amount], REMOVEFILTERS (), Sales[Order Date] >= dt"2024-01-01", Sales[Order Date] <= dt"2024-12-31", Product[Category] = "Audio" ),
  "# New Customers", VAR C = CALCULATETABLE ( VALUES ( Sales[CustomerKey] ), REMOVEFILTERS (), Sales[Order Date] >= dt"2024-01-01", Sales[Order Date] <= dt"2024-12-31", Product[Category] = "Audio" ) RETURN COUNTROWS ( FILTER ( FirstEver, [@f] >= dt"2024-01-01" && [@f] <= dt"2024-12-31" && Sales[CustomerKey] IN C ) ),
  "Sales Growth %", VAR Cur = CALCULATE ( [Sales Amount], REMOVEFILTERS (), Sales[Order Date] >= dt"2024-01-01", Sales[Order Date] <= dt"2024-12-31", Product[Category] = "Audio" ) VAR Prev = CALCULATE ( [Sales Amount], REMOVEFILTERS (), Sales[Order Date] >= dt"2023-01-01", Sales[Order Date] <= dt"2023-12-31", Product[Category] = "Audio" ) RETURN ( Cur - Prev ) / Prev,
  "Avg Delivery Days", AVERAGEX ( CALCULATETABLE ( SUMMARIZE ( Sales, Sales[Order Number], Sales[Order Date], Sales[Delivery Date] ), REMOVEFILTERS (), Sales[Order Date] >= dt"2024-01-01", Sales[Order Date] <= dt"2024-12-31", Product[Category] = "Audio" ), DATEDIFF ( Sales[Order Date], Sales[Delivery Date], DAY ) ),
  "# Returning Customers", VAR C = CALCULATETABLE ( VALUES ( Sales[CustomerKey] ), REMOVEFILTERS (), Sales[Order Date] >= dt"2024-01-01", Sales[Order Date] <= dt"2024-12-31", Product[Category] = "Audio" ) RETURN COUNTROWS ( FILTER ( FirstEver, [@f] < dt"2024-01-01" && Sales[CustomerKey] IN C ) ),
  "Category Share %", CALCULATE ( [Sales Amount], REMOVEFILTERS (), Sales[Order Date] >= dt"2024-01-01", Sales[Order Date] <= dt"2024-12-31", Product[Category] = "Audio" ) / CALCULATE ( [Sales Amount], REMOVEFILTERS (), Sales[Order Date] >= dt"2024-01-01", Sales[Order Date] <= dt"2024-12-31" ),
  "Sales 30D Avg", CALCULATE ( [Sales Amount], REMOVEFILTERS (), Sales[Order Date] > dt"2024-12-31" - 30, Sales[Order Date] <= dt"2024-12-31", Product[Category] = "Audio" ) / 30 ),
ROW ( "Context", "C Mar 2024",
  "Sales LY", CALCULATE ( [Sales Amount], REMOVEFILTERS (), Sales[Order Date] >= dt"2023-03-01", Sales[Order Date] <= dt"2023-03-31" ),
  "Sales YTD", CALCULATE ( [Sales Amount], REMOVEFILTERS (), Sales[Order Date] >= dt"2024-01-01", Sales[Order Date] <= dt"2024-03-31" ),
  "# New Customers", VAR C = CALCULATETABLE ( VALUES ( Sales[CustomerKey] ), REMOVEFILTERS (), Sales[Order Date] >= dt"2024-03-01", Sales[Order Date] <= dt"2024-03-31" ) RETURN COUNTROWS ( FILTER ( FirstEver, [@f] >= dt"2024-03-01" && [@f] <= dt"2024-03-31" && Sales[CustomerKey] IN C ) ),
  "Sales Growth %", VAR Cur = CALCULATE ( [Sales Amount], REMOVEFILTERS (), Sales[Order Date] >= dt"2024-03-01", Sales[Order Date] <= dt"2024-03-31" ) VAR Prev = CALCULATE ( [Sales Amount], REMOVEFILTERS (), Sales[Order Date] >= dt"2023-03-01", Sales[Order Date] <= dt"2023-03-31" ) RETURN ( Cur - Prev ) / Prev,
  "Avg Delivery Days", AVERAGEX ( CALCULATETABLE ( SUMMARIZE ( Sales, Sales[Order Number], Sales[Order Date], Sales[Delivery Date] ), REMOVEFILTERS (), Sales[Order Date] >= dt"2024-03-01", Sales[Order Date] <= dt"2024-03-31" ), DATEDIFF ( Sales[Order Date], Sales[Delivery Date], DAY ) ),
  "# Returning Customers", VAR C = CALCULATETABLE ( VALUES ( Sales[CustomerKey] ), REMOVEFILTERS (), Sales[Order Date] >= dt"2024-03-01", Sales[Order Date] <= dt"2024-03-31" ) RETURN COUNTROWS ( FILTER ( FirstEver, [@f] < dt"2024-03-01" && Sales[CustomerKey] IN C ) ),
  "Category Share %", 1,
  "Sales 30D Avg", CALCULATE ( [Sales Amount], REMOVEFILTERS (), Sales[Order Date] > dt"2024-03-31" - 30, Sales[Order Date] <= dt"2024-03-31" ) / 30 ),
ROW ( "Context", "D 2024 Germany",
  "Sales LY", CALCULATE ( [Sales Amount], REMOVEFILTERS (), Sales[Order Date] >= dt"2023-01-01", Sales[Order Date] <= dt"2023-12-31", Customer[Country] = "Germany" ),
  "Sales YTD", CALCULATE ( [Sales Amount], REMOVEFILTERS (), Sales[Order Date] >= dt"2024-01-01", Sales[Order Date] <= dt"2024-12-31", Customer[Country] = "Germany" ),
  "# New Customers", VAR C = CALCULATETABLE ( VALUES ( Sales[CustomerKey] ), REMOVEFILTERS (), Sales[Order Date] >= dt"2024-01-01", Sales[Order Date] <= dt"2024-12-31", Customer[Country] = "Germany" ) RETURN COUNTROWS ( FILTER ( FirstEver, [@f] >= dt"2024-01-01" && [@f] <= dt"2024-12-31" && Sales[CustomerKey] IN C ) ),
  "Sales Growth %", VAR Cur = CALCULATE ( [Sales Amount], REMOVEFILTERS (), Sales[Order Date] >= dt"2024-01-01", Sales[Order Date] <= dt"2024-12-31", Customer[Country] = "Germany" ) VAR Prev = CALCULATE ( [Sales Amount], REMOVEFILTERS (), Sales[Order Date] >= dt"2023-01-01", Sales[Order Date] <= dt"2023-12-31", Customer[Country] = "Germany" ) RETURN ( Cur - Prev ) / Prev,
  "Avg Delivery Days", AVERAGEX ( CALCULATETABLE ( SUMMARIZE ( Sales, Sales[Order Number], Sales[Order Date], Sales[Delivery Date] ), REMOVEFILTERS (), Sales[Order Date] >= dt"2024-01-01", Sales[Order Date] <= dt"2024-12-31", Customer[Country] = "Germany" ), DATEDIFF ( Sales[Order Date], Sales[Delivery Date], DAY ) ),
  "# Returning Customers", VAR C = CALCULATETABLE ( VALUES ( Sales[CustomerKey] ), REMOVEFILTERS (), Sales[Order Date] >= dt"2024-01-01", Sales[Order Date] <= dt"2024-12-31", Customer[Country] = "Germany" ) RETURN COUNTROWS ( FILTER ( FirstEver, [@f] < dt"2024-01-01" && Sales[CustomerKey] IN C ) ),
  "Category Share %", 1,
  "Sales 30D Avg", CALCULATE ( [Sales Amount], REMOVEFILTERS (), Sales[Order Date] > dt"2024-12-31" - 30, Sales[Order Date] <= dt"2024-12-31", Customer[Country] = "Germany" ) / 30 ),
ROW ( "Context", "E 2017",
  "Sales LY", CALCULATE ( [Sales Amount], REMOVEFILTERS (), Sales[Order Date] >= dt"2016-01-01", Sales[Order Date] <= dt"2016-12-31" ),
  "Sales YTD", CALCULATE ( [Sales Amount], REMOVEFILTERS (), Sales[Order Date] >= dt"2017-01-01", Sales[Order Date] <= dt"2017-12-31" ),
  "# New Customers", VAR C = CALCULATETABLE ( VALUES ( Sales[CustomerKey] ), REMOVEFILTERS (), Sales[Order Date] >= dt"2017-01-01", Sales[Order Date] <= dt"2017-12-31" ) RETURN COUNTROWS ( FILTER ( FirstEver, [@f] >= dt"2017-01-01" && [@f] <= dt"2017-12-31" && Sales[CustomerKey] IN C ) ),
  "Sales Growth %", VAR Cur = CALCULATE ( [Sales Amount], REMOVEFILTERS (), Sales[Order Date] >= dt"2017-01-01", Sales[Order Date] <= dt"2017-12-31" ) VAR Prev = CALCULATE ( [Sales Amount], REMOVEFILTERS (), Sales[Order Date] >= dt"2016-01-01", Sales[Order Date] <= dt"2016-12-31" ) RETURN ( Cur - Prev ) / Prev,
  "Avg Delivery Days", AVERAGEX ( CALCULATETABLE ( SUMMARIZE ( Sales, Sales[Order Number], Sales[Order Date], Sales[Delivery Date] ), REMOVEFILTERS (), Sales[Order Date] >= dt"2017-01-01", Sales[Order Date] <= dt"2017-12-31" ), DATEDIFF ( Sales[Order Date], Sales[Delivery Date], DAY ) ),
  "# Returning Customers", VAR C = CALCULATETABLE ( VALUES ( Sales[CustomerKey] ), REMOVEFILTERS (), Sales[Order Date] >= dt"2017-01-01", Sales[Order Date] <= dt"2017-12-31" ) RETURN COUNTROWS ( FILTER ( FirstEver, [@f] < dt"2017-01-01" && Sales[CustomerKey] IN C ) ),
  "Category Share %", 1,
  "Sales 30D Avg", CALCULATE ( [Sales Amount], REMOVEFILTERS (), Sales[Order Date] > dt"2017-12-31" - 30, Sales[Order Date] <= dt"2017-12-31" ) / 30 )
)
